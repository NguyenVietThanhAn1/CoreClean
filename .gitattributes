# Enforce consistent line endings
* text=auto

*.bat   text eol=crlf
*.cmd   text eol=crlf

gradlew text eol=lf
*.sh    text eol=lf
*.kt    text eol=lf
*.kts   text eol=lf
*.java  text eol=lf
*.xml   text eol=lf
*.json  text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.properties text eol=lf

# Binaries — no line-ending conversion
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.keystore binary
*.jks   binary
*.jar   binary
*.aar   binary
*.zip   binary
